{
  "name": "consciobite",
  "version": "1.0.0",
  "private": true,
  "description": "Repo-root tooling only. The application lives in backend/ and frontend/, each with its own package.json.",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"backend/{src,__tests__}/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"backend/{src,__tests__}/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\""
  },
  "lint-staged": {
    "backend/{src,__tests__}/**/*.js": "prettier --write",
    "frontend/src/**/*.{js,jsx,css}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2"
  }
}
