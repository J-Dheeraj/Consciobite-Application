PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
# REQUIRED in production - app will refuse to start without this
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
DB_PATH=./consciobite.db
LOG_LEVEL=info
NODE_ENV=development
SENTRY_DSN=

# Production database (Turso). Leave these unset locally: the API then uses
# the local SQLite file at DB_PATH. The names must match exactly.
# Setup and failure modes: backend/docs/turso.md
# TURSO_DATABASE_URL=libsql://consciobite-<you>.turso.io
# TURSO_AUTH_TOKEN=
# Run the libsql driver on the local file instead of better-sqlite3
# (CI runs the test suite both ways)
# DB_DRIVER=libsql
