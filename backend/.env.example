PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
# REQUIRED in production - app will refuse to start without this
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
DB_PATH=./consciobite.db
# Production database (Turso). Leave both empty locally to use the DB_PATH file.
# Names must be exact: any other name is ignored and the API falls back to the
# local file, which Render wipes on every restart. See backend/docs/turso.md.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DB_DRIVER=libsql runs the libsql driver on the local file (no network).
DB_DRIVER=
LOG_LEVEL=info
NODE_ENV=development
SENTRY_DSN=
