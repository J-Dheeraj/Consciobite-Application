{
  "name": "consciobite-backend",
  "version": "2.0.0",
  "description": "Consciobite API - GreenGrade sustainability scoring for food products",
  "engines": {
    "node": ">=22 <23"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node -e \"require('./src/db/schema').getDb(); require('./src/db/migrate').runMigrations()\"",
    "backup": "node scripts/backup.js",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint src/ __tests__/",
    "format": "prettier --write \"src/**/*.js\" \"__tests__/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"__tests__/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "libsql": "0.5.29",
    "node-cache": "^5.1.2",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 63,
        "functions": 80,
        "lines": 82
      }
    }
  }
}
